# Runtime environment mode: development, test, or production
APP_ENV=development

# Database connection URL (PostgreSQL in production/preview, SQLite in local development)
DATABASE_URL=sqlite:///./pii-guard.db

# Public frontend HTTP(S) origin URL
PUBLIC_APP_URL=http://localhost:5173

# WorkOS API Key for backend authentication (keep secret; never commit)
WORKOS_API_KEY=

# WorkOS Client ID
WORKOS_CLIENT_ID=client_01M4DB2GA63J2DSF441YB66NZY

# WorkOS cookie encryption key (Fernet 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKOS_COOKIE_PASSWORD=

# WorkOS OAuth callback URL (must match PUBLIC_APP_URL + /api/v1/auth/callback)
WORKOS_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback

# Enable development session adapters (development/test only; forbidden in production)
DEMO_ADAPTERS_ENABLED=false

# Controls whether presentation test samples appear in the chat composer menu
SHOW_DEMO_SAMPLES=true

# OpenAI API key for LLM responses (keep secret; never commit)
OPENAI_API_KEY=

# OpenAI model identifier for chat completions
OPENAI_MODEL=gpt-4o-mini

# Directory path for temporary and sanitized file storage
STORAGE_DIR=./uploads
