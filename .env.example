# Backend settings: copy this file to apps/api/.env; never expose them through VITE_*.
APP_ENV=development
# SQLite for local setup; PostgreSQL for Vercel production/preview.
DATABASE_URL=sqlite:///./pii-guard.db
# Exact browser origin, used for same-origin login and CSRF validation.
PUBLIC_APP_URL=http://localhost:5173
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this value stable across deployments; at least 32 characters.
SESSION_SECRET=
# Synthetic helpers are development/test only, forbidden in production.
DEMO_ADAPTERS_ENABLED=false
# Chat/LLM/storage settings are added by issue 2 when their services exist.
# The sample menu uses SHOW_DEMO_SAMPLES once implemented; it is not active yet.
